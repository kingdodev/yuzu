# Kopieer naar .env.local en vul in. Zet hier nooit echte waarden in.

# Supabase Postgres: de "Transaction pooler" (poort 6543), voor app én migraties.
# Weglaten = demo met tijdelijke database in .data/demo.
DATABASE_URL=postgres://postgres:wachtwoord@localhost:5432/yuzu

# Online demo: wachtwoord dat de browser vraagt. Met DATABASE_URL laadt de
# deploy dan ook voorbeelddata, en ben je (zolang inloggen niet gebouwd is)
# altijd Frank. Zonder dit wachtwoord geeft Yuzu met database geen toegang.
# DEMO_PASSWORD=kies-een-sterk-wachtwoord
