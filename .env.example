# Kopieer naar .env.local en vul in. Zet hier nooit echte waarden in.

# Supabase Postgres: de "Transaction pooler" (poort 6543), voor app én migraties.
# Weglaten = demo met tijdelijke database in .data/demo.
DATABASE_URL=postgres://postgres:wachtwoord@localhost:5432/yuzu

# Extra slot voor de online demo: wachtwoord dat de browser eerst vraagt.
# Met DATABASE_URL laadt de deploy dan ook voorbeelddata, en kan de eigenaar
# op /inloggen zijn allereerste wachtwoord instellen.
# DEMO_PASSWORD=kies-een-sterk-wachtwoord

# Bijlagen: Supabase Storage (privé-bucket "attachments", wordt bij deploy
# aangemaakt). URL staat in Supabase onder Project Settings → API; de geheime
# sleutel ("secret key", begint met sb_secret_) onder API Keys.
# Zonder deze twee: lokale demo bewaart bijlagen in .data/demo-files; met
# DATABASE_URL zijn bijlagen dan uitgeschakeld.
# SUPABASE_URL=https://jouw-project.supabase.co
# SUPABASE_SECRET_KEY=
